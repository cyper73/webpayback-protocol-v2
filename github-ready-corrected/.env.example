# Database Configuration
# PostgreSQL database URL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/webpayback

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=webpayback

# Application Configuration
NODE_ENV=development
PORT=5000

# Blockchain Configuration
# Polygon Network RPC URL
POLYGON_RPC_URL=https://polygon-rpc.com

# Smart Contract Addresses
WPT_TOKEN_CONTRACT=0x9077051D318b614F915E8A0786D9C78b79d3E07B
POOL_CONTRACT=0x823C0b22b2eaD1A3A857F23e8A1B6c5eB9d2C3f4

# Gas Pool Configuration
GAS_POOL_PRIVATE_KEY=your_private_key_here
GAS_POOL_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# Chainlink Configuration
# Chainlink Node URL (optional)
CHAINLINK_NODE_URL=https://chainlink-node.example.com

# API Keys (optional)
# External API integrations
EXTERNAL_API_KEY=your_api_key_here

# Security Configuration
# Session secret for authentication
SESSION_SECRET=your_session_secret_here

# CORS Configuration
# Allowed origins for cross-origin requests
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# Content Monitoring
# AI Detection sensitivity (0-100)
AI_DETECTION_SENSITIVITY=75

# Fraud Detection
# Fraud detection thresholds
FRAUD_DETECTION_ENABLED=true
MAX_DAILY_REQUESTS_PER_IP=200
MAX_DAILY_REQUESTS_PER_DOMAIN=500

# Creator Rewards
# Minimum reward amount (in WPT)
MIN_REWARD_AMOUNT=0.01
MAX_REWARD_AMOUNT=100.0

# Batch Processing
# Batch size for reward distributions
BATCH_SIZE=50
BATCH_INTERVAL=300000

# Platform Integration
# Enable/disable specific platform monitoring
ENABLE_YOUTUBE_MONITORING=true
ENABLE_INSTAGRAM_MONITORING=true
ENABLE_TIKTOK_MONITORING=true
ENABLE_TWITTER_MONITORING=true
ENABLE_FACEBOOK_MONITORING=true
ENABLE_GITHUB_MONITORING=true