# Configurazione Replit per WebPayback Protocol

# Configurazione delle porte
[[ports]]
localPort = 5000      # Porta INTERNA dell'app Express
externalPort = 80     # Porta ESTERNA (accesso pubblico)

# Configurazione del workflow
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000    # Aspetta che la porta 5000 sia attiva

# Configurazione dell'ambiente
[env]
NODE_ENV = "development"
PORT = "5000"

# Configurazione del linguaggio
[languages.typescript]
pattern = "**/*.{ts,tsx}"
[languages.typescript.languageServer]
start = "typescript-language-server --stdio"

# Configurazione di build
[nix]
channel = "stable-22_11"

[deployment]
run = ["npm", "run", "dev"]
deploymentTarget = "cloudrun"

# Configurazione Git
[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

# Configurazione delle dipendenze
[packager]
language = "nodejs"

[packager.features]
packageSearch = true
guessImports = true
enabledForHosting = false