# WebPayback Protocol - Environment Variables Template
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Blockchain Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_TOKEN_ADDRESS=0x...
WPT_TOKEN_SYMBOL=WPT
WPT_TOKEN_DECIMALS=18

# Pool Addresses (Public blockchain addresses)
POLYGON_PRIMARY_POOL_ADDRESS=0x...
POLYGON_SECONDARY_POOL_ADDRESS=0x...

# Admin Configuration (Set your own secure credentials)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password

# Security (Set your authorized wallet and IP addresses)
FOUNDER_WALLET_ADDRESS=0x...
FOUNDER_AUTHORIZED_IPS=192.168.1.1,10.0.0.1

# External APIs (Get your own API keys)
ALCHEMY_API_KEY=your_alchemy_api_key
CHAINLINK_API_KEY=your_chainlink_api_key
QLOO_API_KEY=your_qloo_api_key
# Humanity Protocol (OAuth + SDK)
# Backend (server-side):
HUMANITY_CLIENT_ID=your_humanity_client_id
HUMANITY_CLIENT_SECRET=your_humanity_client_secret
HUMANITY_REDIRECT_URI=https://your-domain.com/callback
HUMANITY_ENVIRONMENT=sandbox   # production | sandbox (installed connect-sdk v0.0.3)
HUMANITY_RPC_URL=https://rpc.testnet.humanity.org

# Frontend (Vite, must be prefixed with VITE_):
VITE_HUMANITY_CLIENT_ID=your_humanity_client_id
VITE_HUMANITY_REDIRECT_URI=https://your-domain.com/callback
VITE_HUMANITY_ENVIRONMENT=sandbox
